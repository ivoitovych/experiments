# Backend Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env — only commit .env.example

# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database (MySQL) ────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=clinical_user
DB_PASSWORD=change_me_in_prod
DB_NAME=clinical_studio
# Set to true ONLY in development to auto-sync schema (use migrations in prod)
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=1h

# ─── Magic Link Auth ─────────────────────────────────────────────────────────
MAGIC_LINK_EXPIRES_IN=900  # seconds (15 minutes)
# In production, set up a real email provider
MAIL_FROM=noreply@clinicaldatastudio.com

# ─── Encryption ──────────────────────────────────────────────────────────────
# Used by Presidio's encrypt anonymization operator. Must be exactly 16 chars (AES-128).
# Generate: openssl rand -hex 8
ENCRYPTION_KEY=change_me_16chars

# ─── Presidio Services ───────────────────────────────────────────────────────
PRESIDIO_ANALYZER_URL=http://localhost:5001
PRESIDIO_ANONYMIZER_URL=http://localhost:5002

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
